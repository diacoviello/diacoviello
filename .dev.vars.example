# Local secrets for `npm run dev` / `wrangler dev`.
# Copy to .dev.vars (gitignored) and fill in. Production values are set with:
#   npx wrangler secret put RESEND_API_KEY   (etc.)

# From https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare's always-pass test secret; pairs with the dev fallback site key
# in src/shared/contact/ContactForm.jsx. Use your real secret in production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Inbox that receives contact-form messages
CONTACT_TO=you@example.com

# Until diacoviello.com is verified in Resend, its sandbox sender works
# (it can only deliver to your own Resend account's email):
# CONTACT_FROM=onboarding@resend.dev
