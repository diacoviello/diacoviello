{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diacoviello",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only API routes hit the Worker; everything else is served as static assets.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Must be on a domain verified in Resend. Secrets (RESEND_API_KEY,
    // TURNSTILE_SECRET_KEY, CONTACT_TO) are set with `wrangler secret put`.
    "CONTACT_FROM": "diacoviello.com <contact@diacoviello.com>"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
